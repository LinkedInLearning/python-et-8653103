{
  "image": "mcr.microsoft.com/devcontainers/python:3",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "linkedinlearning.linkedinlearning-vscode-theme",
        "ms-toolsai.jupyter",
        "ms-python.python"
      ]
    }
  },
  "onCreateCommand": "pip install jupyter ipywidgets matplotlib numpy pandas requests python-dotenv openai Pillow && echo PS1='\"$ \"' >> ~/.bashrc",
  "postAttachCommand": "git pull --all"
}
// DevContainer Reference: https://code.visualstudio.com/docs/remote/devcontainerjson-reference
